#!/usr/bin/env bash
# Re-runs when this script OR tool-versions/mise config change.
# tool-versions hash: {{ include "dot_tool-versions" | sha256sum }}
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

# make sure we have our path set on a run previous to having a full environment
export GOPATH=$HOME/.go

# so compilers can find zlib
export LDFLAGS="-L$HOMEBREW_PREFIX/opt/zlib/lib"
export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/zlib/include"

mise install

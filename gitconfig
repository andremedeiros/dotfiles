[user]
  name = André Medeiros
  email = hello@andre.cool
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAVg9SA4aL/UIAshxNKCvn5DaOGSfTHrsjqwRe9VnZw/
[alias]
  up = pull --rebase --autostash
  co = checkout
  st = status
  pr = "!gh pr create --web"
  rb = rewrite-branch
  vomit = !git commit -m "$(curl -s https://whatthecommit.com/index.txt)"
[color]
  ui = true
  grep = auto
[push]
  default = current
[branch]
  autosetuprebase = always
[web]
  browser = open
[fetch]
  prune = true
[rebase]
  autosquash = true
  autoStash = true
[diff]
  algorithm = patience
[commit]
  gpgsign = true
  verbose = true
[remote "origin"]
  fetch = +refs/pull/*/merge:refs/remotes/origin/pr/*
[pull]
  rebase = true
[filter "lfs"]
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
[core]
  attributesfile = ~/.gitattributes
[init]
  defaultBranch = main
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[url "https://github.com/"]
	insteadOf = git@github.com:
[url "https://gist.github.com/"]
	insteadOf = git@gist.github.com:

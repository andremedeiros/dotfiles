#!/usr/bin/env ruby

require 'open3'
require 'tempfile'

# Get all tracked, non-binary files in a single process
# -I = skip binary files, -l = filenames only, '' = match any line
stdout, _, status = Open3.capture3('git', 'grep', '-I', '-l', '')

unless status.success?
  $stderr.puts "Error: Not a git repository or git command failed"
  exit 1
end

text_files = stdout.split("\n").select { |f| File.file?(f) }.sort

# Determine output target based on whether stdout is a TTY
interactive = $stdout.tty?

if interactive
  tmpfile = Tempfile.new(['repo2md', '.md'])
  out = tmpfile
else
  out = $stdout
end

begin
  # Generate markdown with file contents
  out.write "# Code Repository\n\n"
  out.write "Total files: #{text_files.length}\n\n"
  out.write "---\n\n"

  text_files.each do |file|
    out.write "## #{file}\n\n"

    # Detect language for syntax highlighting
    ext = File.extname(file).delete_prefix('.')
    lang = ext.empty? ? '' : ext

    content = File.read(file)
    out.write "```#{lang}\n"
    out.write content
    out.write "\n" unless content.end_with?("\n")
    out.write "```\n\n"
    out.write "---\n\n"
  end

  if interactive
    out.close

    # Copy to clipboard (works on macOS, Linux, and Windows via WSL)
    copy_command = case RbConfig::CONFIG['host_os']
    when /darwin/
      'pbcopy'
    when /linux/
      'xclip -selection clipboard'
    when /mswin|mingw|cygwin/
      'clip'
    else
      nil
    end

    if copy_command
      system("#{copy_command} < #{tmpfile.path}")
      $stderr.puts "✓ Markdown with file contents copied to clipboard! (#{text_files.length} files)"
    else
      $stderr.puts "Could not detect clipboard command."
      IO.copy_stream(tmpfile.path, $stdout)
    end
  end
ensure
  if tmpfile
    tmpfile.close unless tmpfile.closed?
    tmpfile.unlink
  end
end
